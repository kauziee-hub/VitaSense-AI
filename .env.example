# Backend (project root). Copy to .env — never commit real secrets.
# Default dev API port for this repo is 8888 (avoids 8000 if another app uses it):
#   python -m uvicorn main:app --host 127.0.0.1 --port 8888

# Chat, document reading and doctor reports. Gemini is preferred; Grok is the fallback provider.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: GEMINI_MODEL=gemini-3.7-flash
# Optional: GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
GROK_API_KEY=your_xai_grok_api_key_here

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Google Places (New) for "doctors near you". Without it the API uses
# OpenStreetMap (free, no key, about one search per second).
# GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Optional: where uploaded records and the local records database live (default: ./data).
# VITASENSE_DATA_DIR=C:/path/to/vitasense-data

# Optional: comma-separated extra browser origins for CORS (e.g. if the Vite dev server uses another port).
# CORS_ORIGINS=http://127.0.0.1:5174
