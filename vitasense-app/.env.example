# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (not secret).
# Server the app talks to (phone on Wi-Fi: http://<your-computer-LAN-IP>:8888)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8888

# Google sign-in for Gmail order import (see README). Leave empty to hide Gmail sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
